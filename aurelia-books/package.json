{
  "name": "shanbooks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "fixtures": "node scripts/generate-test-fixtures.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:i18n": "node scripts/audit-ui-strings.mjs",
    "test:e2e": "playwright test",
    "test:e2e:baseline": "playwright test tests/e2e/baseline.spec.js",
    "test:all": "npm run test:unit && npm run test:e2e",
    "preview": "vite preview",
    "android:sync": "vite build && cap sync android",
    "android:apk": "vite build && cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
