    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.33.0",
    "unplugin-parcel-macros": "^0.2.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.12"
