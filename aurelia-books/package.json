    "@capgo/capacitor-share-target": "^8.0.63",
    "@react-spectrum/s2": "^1.8.2",
    "@web-ppt/core": "^0.4.5",
    "dompurify": "^3.4.17",
    "epubjs": "^0.3.93",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
